# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/
# Turbopack dev-server writes its error-overlay output to the Windows null
# device path ("nul"); a Windows/Node quirk sometimes creates a literal file.
/nul

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/

# Next.js compiles .sass files directly — these are stale IDE file-watcher output
/src/app/styles/globals.css
/src/app/styles/globals.css.map
**/*.module.css
**/*.module.css.map

/.idea/
/AGENTS.md

# data/houdini-icons.pack: SideFX's icon set, packed from a local Houdini install
# by `npm run import_houdini_icons` (SideFX's artwork, so not committed).
/data/

# Database dumps (e.g. on thinkguy, taken before deploys that run migrations)
/backups/

# Cron job output on thinkguy (crontab line in the README's Production section)
/cron-logs/
