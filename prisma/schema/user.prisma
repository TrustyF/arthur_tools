enum UserRole {
  USER
  ADMIN
}

// Only admins sign in for now (Credentials, see src/auth.ts) — no OAuth
// adapter tables until public accounts are actually needed.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(USER)
  createDate   DateTime @default(now())
}
