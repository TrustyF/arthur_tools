{
	"name": "arthur_tools",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"postinstall": "prisma generate",
		"build": "next build",
		"start": "next start",
		"migrate_deploy": "prisma migrate deploy",
		"lint": "eslint && npm run lint:colors && npm run lint:styles",
		"lint:colors": "node scripts/check-color-literals.mjs",
		"lint:styles": "stylelint \"src/**/*.sass\"",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"studio": "npx prisma studio",
		"prisma_generate": "npx prisma generate",
		"prisma_migrate": "npx prisma migrate dev",
		"compose": "docker compose up -d --wait db && npx prisma migrate deploy",
		"create_admin": "tsx src/scripts/create-admin.ts",
		"import_houdini_icons": "tsx src/scripts/import-houdini-icons.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"adm-zip": "^0.6.1",
		"arktype": "^2.0.0",
		"bcryptjs": "^3.0.3",
		"diff": "^9.0.0",
		"lucide-react": "^1.31.0",
		"next": "^16.3.0",
		"next-auth": "^5.0.0-beta.32",
		"pg": "^8.22.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"shiki": "^3.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/adm-zip": "^0.5.8",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"dotenv": "^17.4.2",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"eslint-plugin-check-file": "^3.3.1",
		"husky": "^9.1.7",
		"prisma": "^7.8.0",
		"sass": "^1.101.0",
		"stylelint": "^17.15.0",
		"tsx": "^4.23.12",
		"typescript": "^5"
	}
