# Postgres (docker compose `db` service). Port 5433 so it can run alongside
# review_website_nextjs's database on 5432.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=arthur_tools
DATABASE_URL=postgresql://user:password@localhost:5433/arthur_tools

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# Self-hosted (next start / Docker) — Auth.js rejects requests from untrusted hosts otherwise.
AUTH_TRUST_HOST=true

SITE_URL=http://localhost:3000

# --- thinkguy only (see docker-compose.prod.yml) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# SITE_URL=https://tools.arthursirjacobs.com
# WEB_PORT=3004
# DB_PORT=5435
# CLOUDFLARE_TUNNEL_TOKEN=
# Description images go to this R2 bucket (docker-compose.prod.yml forces the
# r2 driver). Token: Object Read & Write, scoped to this bucket only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://media.arthursirjacobs.com
# POSTGRES_PASSWORD: use a long random hex string (it goes into a URL unescaped)
