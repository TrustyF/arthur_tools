# Postgres (docker compose `db` service). Port 5433 so it can run alongside
# review_website_nextjs's database on 5432.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=arthur_tools
DATABASE_URL=postgresql://user:password@localhost:5433/arthur_tools

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# Self-hosted (next start / Docker) — Auth.js rejects requests from untrusted hosts otherwise.
AUTH_TRUST_HOST=true

SITE_URL=http://localhost:3000

# --- thinkguy only (see docker-compose.prod.yml) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# SITE_URL=https://tools.arthursirjacobs.com
# WEB_PORT=3004
# DB_PORT=5435
# CLOUDFLARE_TUNNEL_TOKEN=
# POSTGRES_PASSWORD: use a long random hex string (it goes into a URL unescaped)
