# Postgres (docker compose `db` service). Port 5433 so it can run alongside
# review_website_nextjs's database on 5432.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=arthur_tools
DATABASE_URL=postgresql://user:password@localhost:5433/arthur_tools

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# Self-hosted (next start / Docker) — Auth.js rejects requests from untrusted hosts otherwise.
AUTH_TRUST_HOST=true

SITE_URL=http://localhost:3000
